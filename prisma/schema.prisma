generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  passwordHash   String?
  roadmapData    Json?
  createdAt      DateTime       @default(now())
  roadmaps       Roadmap[]
  notifications  Notification[]
  savedEvents    SavedEvent[]
  sessions       UserSession[]
  quizAttempts   QuizAttempt[]
  skillProgress  UserSkillProgress[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuizAttempt {
  id               String    @id @default(cuid())
  userId           String
  skillId          String
  skillName        String
  skillFingerprint String
  eventId          String?
  questions        Json
  score            Int       @default(0)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id          String   @id @default(cuid())
  userId      String
  careerGoal  String
  targetLevel String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
  user        User     @relation(fields: [userId], references: [id])
}

model Skill {
  id                String               @id @default(cuid())
  roadmapId         String
  skillId           String
  skillName         String
  category          String
  description       String
  prerequisites     String[]
  estimatedHours    Int
  roadmap           Roadmap              @relation(fields: [roadmapId], references: [id])
}

model UserSkillProgress {
  id               String   @id @default(cuid())
  userId           String
  skillId          String
  skillFingerprint String
  confidence       Int      @default(0)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Event {
  id                 String      @id @default(cuid())
  providerId         String      @unique
  source             String
  title              String
  description        String?
  category           String
  startAt            DateTime
  endAt              DateTime?
  city               String?
  region             String?
  country            String?
  latitude           Float?
  longitude          Float?
  online             Boolean     @default(false)
  price              Decimal?
  registrationUrl    String?
  verificationStatus String      @default("unverified")
  lastVerifiedAt     DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  savedEvents        SavedEvent[]
}

model SavedEvent {
  id      String   @id @default(cuid())
  userId  String
  eventId String
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  title          String
  message        String
  relevanceText  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  idempotencyKey String    @unique
  user           User      @relation(fields: [userId], references: [id])
}

model EventPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  city           String?
  radiusKm       Int      @default(50)
  onlineEvents   Boolean  @default(true)
  inPersonEvents Boolean  @default(true)
  timezone       String   @default("UTC")
  updatedAt      DateTime @updatedAt
}
